<Window x:Class="GapLogger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gap &amp; Tick Logger" Height="300" Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Map Name A:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                 Text="{Binding MapNameA, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Margin="8,4" VerticalAlignment="Center"
                   FontFamily="Consolas" Text="{Binding MapInfoA}" TextTrimming="CharacterEllipsis"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Map Name B:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                 Text="{Binding MapNameB, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,4" VerticalAlignment="Center"
                   FontFamily="Consolas" Text="{Binding MapInfoB}" TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Check" Width="80" Height="32" Margin="0,0,8,0"
                    Command="{Binding CheckCommand}"/>
            <Button Content="Start" Width="100" Height="32" Margin="0,0,8,0"
                    Command="{Binding StartCommand}"/>
            <Button Content="Stop" Width="100" Height="32"
                    Command="{Binding StopCommand}"/>
            <Button Content="Open Folder" Width="100" Height="32" Margin="8,0,0,0"
                    Click="OnOpenFolder"/>
        </StackPanel>

        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                Margin="0,16,0,0" Padding="8" Background="#F5F5F5"
                BorderBrush="#DDD" BorderThickness="1">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontFamily="Consolas"/>
        </Border>
    </Grid>
</Window>
